{
  "name": "themis",
  "version": "2.7.1",
  "private": true,
  "description": "Themis 2.0 - PWA de contagem de estoque do Grupo Ice Beer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @themis/web",
    "dev:api": "npm run dev --workspace @themis/api",
    "build": "npm run build --workspace @themis/shared && npm run build --workspace @themis/web && npm run build --workspace @themis/api",
    "build:hostinger": "npm ci --include=dev && npm run build",
    "start": "node apps/api/dist/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run verificar-versao && npm run typecheck && npm run lint && npm test && npm run build",
    "versao": "node scripts/versionar.mjs",
    "versao:marcar": "node scripts/marcar-versao.mjs",
    "verificar-versao": "node scripts/verificar-versao.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty",
    "auditar-produtos": "npm run build --workspace @themis/shared && node --env-file=apps/web/.env scripts/auditar-produtos.mjs",
    "deploy-rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy-indexes": "npx firebase-tools deploy --only firestore:indexes"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^17.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
