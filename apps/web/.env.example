# Configuração do Firebase (cliente).
# Copie para .env e preencha com os valores do projeto `auditoria-icebeer`.
# Os valores estão em www/firebase-config.js do Themis 1.x, ou no
# Console Firebase > Configurações do projeto > Seus apps > Configuração do SDK.
#
# Credencial web do Firebase é pública por design — vai no bundle do navegador.
# O que protege os dados são as Firestore Security Rules e o Auth, não o sigilo daqui.
# Ainda assim ficam em .env para não irem ao repositório.

# Endereço da API. Deixe vazio para usar /api na mesma origem (recomendado).
# Só preencha se o app Node ficar num subdomínio, ex.: https://api.seudominio.com/api
VITE_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=auditoria-icebeer.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=auditoria-icebeer
VITE_FIREBASE_STORAGE_BUCKET=auditoria-icebeer.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
