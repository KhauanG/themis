# Configuração do Apache/LiteSpeed da Hostinger para o PWA.
# Este arquivo é copiado para o dist/ pelo Vite e vai junto no deploy.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SPA: /auditoria, /historico e /produtos não existem como arquivo no servidor.
  # Sem isto, recarregar a página nessas rotas devolve 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # O service worker precisa ser revalidado a cada carregamento; se ficar em cache,
  # o usuário trava numa versão antiga do app e o deploy por push perde o sentido.
  <FilesMatch "(sw|registerSW|workbox-.*)\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(webmanifest|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Arquivos com hash no nome nunca mudam de conteúdo: cache longo é seguro.
  <FilesMatch "\.[0-9a-zA-Z_-]{8,}\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # A câmera do leitor de código é usada pela própria página; nada de terceiros.
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=()"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
