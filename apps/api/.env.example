# Copie para .env. NUNCA versione o .env preenchido.

PORT=3000
NODE_ENV=development

# Origens autorizadas a chamar a API (separadas por vírgula).
# Em produção, apenas o domínio do PWA.
CORS_ORIGINS=http://localhost:5173

# Endpoint do ERP (o mesmo usado pelo Themis 1.x).
ERP_API_URL=https://erp.nuvem3.com.br/apiv1/Estoque/EstoqueInventarioAtualizar
ERP_LISTAR_URL=https://erp.nuvem3.com.br/apiv1/Estoque/EstoqueQuantidadePorLojaListar
ERP_TIMEOUT_MS=10000
# A listagem traz o estoque inteiro da loja; 10s não bastam.
ERP_LISTAR_TIMEOUT_MS=45000

# Segredo compartilhado que o ERP deve enviar no header `x-themis-webhook-secret`
# ao chamar POST /api/webhook/estoque. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem isso o webhook fica desabilitado — endpoint aberto que escreve no estoque
# permitiria a qualquer um alterar a contagem.
WEBHOOK_SECRET=
