{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "./src",
    // Só checagem de tipos: quem produz `dist/server.js` é o esbuild (build.mjs).
    "outDir": "./dist-types"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
